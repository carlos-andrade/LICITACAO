{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/carlos-andrade/LICITACAO/blob/main/ARQUITETURA/schemas/cotacao.schema.json",
  "title": "Cotação de fornecedor",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "opportunity_id", "supplier_name", "item_id", "unit_price", "currency", "quote_status", "quoted_at"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "id": { "type": "string", "minLength": 3 },
    "opportunity_id": { "type": "string", "minLength": 3 },
    "item_id": { "type": "string", "minLength": 3 },
    "supplier_id": { "type": ["string", "null"] },
    "supplier_name": { "type": "string", "minLength": 1 },
    "supplier_tax_id": { "type": ["string", "null"] },
    "product_name": { "type": ["string", "null"] },
    "manufacturer": { "type": ["string", "null"] },
    "unit_price": { "type": "number", "minimum": 0 },
    "currency": { "const": "BRL" },
    "quoted_quantity": { "type": ["number", "null"], "exclusiveMinimum": 0 },
    "available_quantity": { "type": ["number", "null"], "minimum": 0 },
    "freight_total": { "type": ["number", "null"], "minimum": 0 },
    "taxes_included": { "type": ["boolean", "null"] },
    "delivery_days": { "type": ["integer", "null"], "minimum": 0 },
    "valid_until": { "type": ["string", "null"], "format": "date-time" },
    "technical_evidence_document_ids": { "type": "array", "items": { "type": "string" } },
    "quote_source_url": { "type": ["string", "null"], "format": "uri" },
    "quote_status": { "enum": ["indicative_web_price", "requested", "formal_received", "validated", "rejected", "expired"] },
    "quoted_at": { "type": "string", "format": "date-time" },
    "notes": { "type": "array", "items": { "type": "string" } }
  }
}