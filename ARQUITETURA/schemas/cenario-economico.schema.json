{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/carlos-andrade/LICITACAO/blob/main/ARQUITETURA/schemas/cenario-economico.schema.json",
  "title": "Cenário econômico de item",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "opportunity_id", "item_id", "revenue_total", "quantity", "acquisition_total", "other_costs_total", "taxes_total", "total_cost", "profit", "margin_on_revenue", "evidence_status", "calculated_at"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "id": { "type": "string", "minLength": 3 },
    "opportunity_id": { "type": "string", "minLength": 3 },
    "item_id": { "type": "string", "minLength": 3 },
    "scenario_name": { "type": "string", "minLength": 1 },
    "quantity": { "type": "number", "exclusiveMinimum": 0 },
    "sale_unit_price": { "type": "number", "minimum": 0 },
    "revenue_total": { "type": "number", "minimum": 0 },
    "acquisition_unit_price": { "type": ["number", "null"], "minimum": 0 },
    "acquisition_total": { "type": "number", "minimum": 0 },
    "taxes_total": { "type": "number", "minimum": 0 },
    "das_allocated": { "type": "number", "minimum": 0 },
    "freight_total": { "type": "number", "minimum": 0 },
    "local_delivery_total": { "type": "number", "minimum": 0 },
    "handling_total": { "type": "number", "minimum": 0 },
    "financial_costs_total": { "type": "number", "minimum": 0 },
    "other_costs_total": { "type": "number", "minimum": 0 },
    "contingency_total": { "type": "number", "minimum": 0 },
    "other_costs_including_das": { "type": "number", "minimum": 0 },
    "total_cost": { "type": "number", "minimum": 0 },
    "profit": { "type": "number" },
    "margin_on_revenue": { "type": "number" },
    "markup_on_cost": { "type": ["number", "null"] },
    "target_profit_margin": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "target_profit_margin_percent": { "type": "string" },
    "target_profit": { "type": "number", "minimum": 0 },
    "maximum_acquisition_total_for_target": { "type": "number" },
    "maximum_acquisition_unit_price_for_target": { "type": "number" },
    "currency": { "const": "BRL" },
    "evidence_status": { "enum": ["draft_estimate", "partially_verified", "verified"] },
    "input_status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tax_confirmed", "freight_confirmed", "technical_compliance_confirmed", "supplier_capacity_confirmed"],
      "properties": {
        "tax_confirmed": { "type": "boolean" },
        "freight_confirmed": { "type": "boolean" },
        "technical_compliance_confirmed": { "type": "boolean" },
        "supplier_capacity_confirmed": { "type": "boolean" }
      }
    },
    "assumptions": { "type": "array", "items": { "type": "string" } },
    "pending_costs": { "type": "array", "items": { "type": "string" } },
    "blocking_issues": { "type": "array", "items": { "type": "string" } },
    "recommendation": { "enum": ["PARTICIPATION_NOT_CLEARED", "MEETS_TARGET_MARGIN", "BELOW_TARGET"] },
    "source_document_ids": { "type": "array", "items": { "type": "string" } },
    "calculated_at": { "type": "string", "format": "date-time" }
  }
}